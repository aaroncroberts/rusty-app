    metal::float2 _e15 = top_left;
    metal::float2 _e17 = inner_half_size;
    metal::float2 _e19 = inner_half_size;
    float _e21 = rounded_box_sdf((frag_coord - _e15) - _e17, _e19, 0.0);
    return _e21;
}

float select_border_radius(
