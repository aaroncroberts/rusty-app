    metal::float4 position [[position]];
    metal::float4 color [[user(loc0), center_perspective]];
};
vertex solid_vs_mainOutput solid_vs_main(
  solid_vs_mainInput varyings [[stage_in]]
, constant Globals& globals [[buffer(0)]]
) {
    const SolidVertexInput input = { varyings.position, {}, varyings.color };
    SolidVertexOutput out = {};
    out.color = input.color;
    metal::float4x4 _e7 = globals.transform;
    out.position = _e7 * metal::float4(input.position, 0.0, 1.0);
    SolidVertexOutput _e13 = out;
    const auto _tmp = _e13;
    return solid_vs_mainOutput { _tmp.position, _tmp.color };
}


struct solid_fs_mainInput {
    metal::float4 color [[user(loc0), center_perspective]];
};
struct solid_fs_mainOutput {
    metal::float4 member_1 [[color(0)]];
};
fragment solid_fs_mainOutput solid_fs_main(
  solid_fs_mainInput varyings_1 [[stage_in]]
, metal::float4 position [[position]]
) {
