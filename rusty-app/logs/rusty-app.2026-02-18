// language: metal2.4
#include <metal_stdlib>
#include <simd/simd.h>

using metal::uint;
struct DefaultConstructible {
    template<typename T>
    operator T() && {
        return T {};
    }
};

struct Globals {
    metal::float4x4 transform;
};
struct GradientVertexInput {
    metal::float2 v_pos;
    char _pad1[8];
    metal::uint4 colors_1_;
    metal::uint4 colors_2_;
    metal::uint4 colors_3_;
    metal::uint4 colors_4_;
    metal::uint4 offsets;
    metal::float4 direction;
};
struct GradientVertexOutput {
    metal::float4 position;
    metal::float2 raw_position;
    char _pad2[8];
    metal::uint4 colors_1_;
    metal::uint4 colors_2_;
    metal::uint4 colors_3_;
    metal::uint4 colors_4_;
    metal::uint4 offsets;
    metal::float4 direction;
};
struct type_7 {
    metal::float4 inner[8];
};
struct type_8 {
    float inner[8];
};
constant metal::float3x4 to_lms = metal::float3x4(metal::float4(0.4121656, 0.2118591, 0.088309795, 0.0), metal::float4(0.5362752, 0.68071896, 0.28184742, 0.0), metal::float4(0.051457565, 0.10740658, 0.63026136, 0.0));
constant metal::float3x4 to_rgb = metal::float3x4(metal::float4(4.0767245, -3.307217, 0.23075905, 0.0), metal::float4(-1.2681438, 2.6093323, -0.34113443, 0.0), metal::float4(-0.0041119885, -0.7034763, 1.7068626, 0.0));

metal::float4 interpolate_color(
    metal::float4 from,
    metal::float4 to,
    float factor
) {
    metal::float4 color = {};
    metal::float3 lms_a = metal::pow(from * to_lms, metal::float3(0.33333334, 0.33333334, 0.33333334));
    metal::float3 lms_b = metal::pow(to * to_lms, metal::float3(0.33333334, 0.33333334, 0.33333334));
    metal::float3 mixed = metal::mix(lms_a, lms_b, factor);
    color = to_rgb * ((mixed * mixed) * mixed);
    color.w = metal::mix(from.w, to.w, factor);
    metal::float4 _e27 = color;
    return _e27;
}

float random(
