float rounded_box_sdf(
    metal::float2 to_center,
    metal::float2 size,
    float radius
) {
    return metal::length(metal::max((metal::abs(to_center) - size) + metal::float2(radius, radius), metal::float2(0.0, 0.0))) - radius;
}

float distance_alg(
