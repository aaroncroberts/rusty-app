float rounded_box_sdf(
    metal::float2 to_center,
    metal::float2 size,
    float radius
) {
    return metal::length(metal::max((metal::abs(to_center) - size) + metal::float2(radius, radius), metal::float2(0.0, 0.0))) - radius;
}

float distance_alg(
    metal::float2 frag_coord,
    metal::float2 position,
    metal::float2 size_1,
    float radius_1
) {
    metal::float2 inner_half_size = {};
    metal::float2 top_left = {};
    inner_half_size = (size_1 - (metal::float2(radius_1, radius_1) * 2.0)) / metal::float2(2.0);
