// language: metal2.4
#include <metal_stdlib>
#include <simd/simd.h>

using metal::uint;
struct DefaultConstructible {
    template<typename T>
    operator T() && {
        return T {};
    }
};

struct Globals {
    metal::float4x4 transform;
};
struct GradientVertexInput {
    metal::float2 v_pos;
    char _pad1[8];
    metal::uint4 colors_1_;
